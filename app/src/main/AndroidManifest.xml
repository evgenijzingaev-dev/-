<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.health.READ_STEPS"/>
    <uses-permission android:name="android.permission.health.READ_WEIGHT"/>
    <queries><package android:name="com.google.android.apps.healthdata"/></queries>
    <application android:usesCleartextTraffic="false" android:allowBackup="false" android:label="Умная корзина" android:theme="@style/AppTheme" android:supportsRtl="true" android:icon="@drawable/ic_basket">
        <provider android:name=".UpdateProvider" android:authorities="${applicationId}.updates" android:exported="false" android:grantUriPermissions="true"/>
        <activity android:name=".ChatGptSettingsActivity" android:exported="false"/>
        <activity android:name=".FamilyHealthActivity" android:exported="false"/>
        <activity android:name=".HealthPrivacyActivity" android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
        </activity>
        <activity-alias android:name=".ViewHealthPermissionUsageActivity" android:targetActivity=".HealthPrivacyActivity"
            android:exported="true" android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>
        <activity android:name=".NutritionActivity" android:exported="false"/>
        <activity android:name=".CatalogSyncActivity" android:exported="false"/>
        <activity android:name=".CartTransferActivity" android:exported="false"/>
        <activity android:name=".BatchQuoteActivity" android:exported="false"/>
        <activity android:name=".StoreActivity" android:exported="false"/>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <intent-filter><action android:name="android.intent.action.SEND"/><category android:name="android.intent.category.DEFAULT"/><data android:mimeType="text/plain"/></intent-filter>
        </activity>
    </application>
</manifest>
